# knapcio/GLM-5.3-Flash-4x-DGX-Spark-TP4 @ 770d115 on this fleet -- 262k lane.
# Use: cp to the knapcio checkout, then  ENV_FILE=env.262k bash start.sh serve   (from the head, rank 0).
# Head Reddie (rank 0), then Spark4, Asusi, Bluey. Edit HOSTS/IPS/paths for your fleet.
HOSTS="local tonyspark4@192.168.192.4 tonyspark3@192.168.192.3 tonyspark1@192.168.192.1"
SSH_OPTS="-o BatchMode=yes"
IPS="192.168.192.2 192.168.192.4 192.168.192.3 192.168.192.1"
FABRIC_IFACE=enp1s0f0np0
IB_HCA=rocep1s0f0                  # single rail: our second ConnectX-7 port is not addressed on every node
NCCL_IB_GID_INDEX=3
IMAGE=glm53-roce:v11-b58f34ea      # knapcio Dockerfile.roce built on our v11 image
MODEL_DIR=/var/tmp/models/glm-quant-mix/lossless8
DRAFT_DIR=/var/tmp/models/GLM-5.3-Flash-DFlash2-fp8blk
CTN=glm53k
OVERLAY_REMOTE=/srv/glm53-knapcio   # same path on every node; not under a dir any preserved container bind-mounts
source profiles/current.env
# --- overrides AFTER the profile (only plain variables work here; see README "gotchas") ---
HOST_BIND=0.0.0.0
PORT=8000
SERVED_NAME=glm-5.3-flash
MAX_MODEL_LEN=262144
DEFAULT_EFFORT=low                 # the fleet default since 2026-09-29 (see README, "Reasoning effort")
