# 2026-09-29 knapcio 770d115 on Tony's switched fleet. Head Reddie (rank 0), ranks 1-3 Spark4, Asusi, Bluey.
HOSTS="local tonyspark4@192.168.192.4 tonyspark3@192.168.192.3 tonyspark1@192.168.192.1"
SSH_OPTS="-o BatchMode=yes"
IPS="192.168.192.2 192.168.192.4 192.168.192.3 192.168.192.1"
FABRIC_IFACE=enp1s0f0np0
IB_HCA=rocep1s0f0                     # second rail is only configured on Spark4/Bluey: single rail
NCCL_IB_GID_INDEX=3
IMAGE=glm53-roce:v11-b58f34ea
MODEL_DIR=/var/tmp/models/glm-quant-mix/lossless8
DRAFT_DIR=/var/tmp/models/GLM-5.3-Flash-DFlash2-fp8blk
CTN=glm53k
OVERLAY_REMOTE=/srv/glm53-knapcio
source profiles/current.env
# serve on the existing endpoint so clients keep working
HOST_BIND=0.0.0.0
PORT=8000
SERVED_NAME=glm-5.3-flash
MAX_MODEL_LEN=500000
# 2026-09-29 8:55 PM ET (Kai, Tony ask): same as .env.500k but reasoning effort LOW (template has no off). Fresh CTN + overlay path per the repo preservation rule; old glm53k-r* stay stopped, not removed.
DEFAULT_EFFORT=low
CTN=glm53kl
OVERLAY_REMOTE=/srv/glm53-knapcio-low
